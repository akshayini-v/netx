# ==========================================
# SecureTransfer Environment Configuration
# ==========================================

# Flask Server Port
PORT=5005

# Secret Key for Flask Session Signature (REQUIRED for production; if unset an
# ephemeral random key is generated at startup and sessions won't persist).
SECRET_KEY=your_secure_random_hex_key_here_32_bytes

# Comma-separated list of allowed CORS origins (frontend dev servers)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174

# Database Configuration (Defaults to local SQLite)
DATABASE_PATH=securetransfer.db

# Storage Directory for Encrypted Payloads
STORAGE_DIR=storage/encrypted

# Frontend Vite Port (Development)
VITE_PORT=5173
